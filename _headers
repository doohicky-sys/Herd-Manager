/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://i.ibb.co https://*.ibb.co data: blob:; connect-src 'self' https://*.supabase.co https://api.imgbb.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# ── Explicit Content-Type on HTML ────────────────────────────────────────────
# Fix for: Safari forcing a 0KB "download" instead of rendering the page.
#
# Cause: X-Content-Type-Options: nosniff (set above, and correctly so — it's
# good security practice) tells the browser "never guess the content type,
# only trust what the server explicitly says." That's fine as long as the
# server always sends the right Content-Type. Cloudflare Pages' Direct Upload
# has a known, intermittent issue (documented in their own community forum)
# where certain deployments serve a page with a missing or wrong
# Content-Type header. Combined with nosniff, Safari then has nothing valid
# to render and offers the raw bytes as a download instead — which is
# exactly the symptom your partner hit.
#
# Fix: force the correct type explicitly on every HTML route, so there is
# nothing left for Cloudflare to get wrong or omit.
/
  Content-Type: text/html; charset=UTF-8

/index.html
  Content-Type: text/html; charset=UTF-8

/*.html
  Content-Type: text/html; charset=UTF-8

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=UTF-8

# ── Explicit no-cache on the service worker file itself ─────────────────────
# Real, confirmed cause of a device getting stuck on an old app version even
# after several genuine deploys: a service worker only checks for updates to
# ITSELF when the page navigates fresh — simply reopening an already-running
# PWA from the home screen, or refreshing without a full close, may never
# trigger that check at all, so the OLD service worker script can keep
# running indefinitely regardless of what's actually been deployed since.
# On top of that, without an explicit Cache-Control here, sw.js is just
# another static file to Cloudflare's edge cache — so even when a check DOES
# happen, it could be served a cached copy of the old script rather than a
# genuinely fresh one. no-cache (not no-store) lets the file still be kept
# on disk, but forces the browser to always revalidate with the server
# before using it — the standard, documented fix for exactly this failure
# mode, cheap because an unchanged file still just gets a fast 304 back.
/sw.js
  Content-Type: application/javascript; charset=UTF-8
  Cache-Control: no-cache

# Explicit Content-Type for the self-hosted fonts, same defensive reasoning
# as above — with nosniff active, a wrong or missing type here would mean
# the font silently fails to load rather than falling back gracefully, so
# it's worth being explicit rather than trusting auto-detection. Using the
# documented-safe /folder/* pattern (a single trailing splat) rather than a
# more specific extension-match pattern that isn't confirmed to work the
# same way.
/fonts/*
  Content-Type: font/woff2
